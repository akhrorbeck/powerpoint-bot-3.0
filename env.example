# Haqiqiy qiymatlarni GitHub'ga YOZMANG. Ularni hostingdagi Environment Variables bo'limiga kiriting.

# Majburiy: @BotFather bergan token
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Majburiy: Google AI Studio (Gemini) API kaliti. Kalitsiz bot taqdimot yarata olmaydi.
GEMINI_API_KEY=

# Ixtiyoriy: model nomi (asosiy topilmasa, bot zaxira modellarni o'zi sinaydi)
GEMINI_MODEL=gemini-3.8-flash

# Ixtiyoriy: majburiy kanallar, vergul bilan. Bot shu kanallarda ADMIN bo'lishi shart.
# Bo'sh qoldirsangiz, a'zolik tekshirilmaydi.
REQUIRED_CHANNELS=

# Ixtiyoriy: cheksiz foydalanadigan adminlar (Telegram ID, vergul bilan). ID ni @userinfobot dan bilib oling.
ADMIN_IDS=

# Ixtiyoriy: bepul foydalanuvchi uchun kuniga nechta taqdimot
DAILY_LIMIT=3

# Ixtiyoriy: 0 qo'ysangiz, bot o'zini-o'zi "uyg'otib" turmaydi
KEEPALIVE=1

# Ixtiyoriy: bir vaqtda nechta taqdimot yaratilsin (bepul hostingda 1-2 yetarli)
MAX_PARALLEL=2
